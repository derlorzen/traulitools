# Beim ersten Aufruf der App legst du Benutzer und Passwort im Browser an.
# Optional, empfohlen bei öffentlicher URL: Einrichtungscode, ohne den niemand das Konto anlegen kann.
SETUP_TOKEN=

# Schlüssel zum Verschlüsseln gespeicherter Zugangsdaten (Shopware-Secret).
# Leer = wird automatisch als /data/secret.key angelegt (dann /data persistent mounten!).
SECRET_KEY=

# Datenbank (Persistent Storage nach /data mounten)
DB_PATH=/data/preisradar.db
COMPETITORS_FILE=/data/competitors.json
TZ=Europe/Berlin

# Zeitplan: Stunden (lokale Zeit), zweimal täglich
SCRAPE_HOURS=6,18
# Mindestabstand zwischen zwei Prüfungen desselben Produkts (Stunden)
MIN_INTERVAL_HOURS=10

PORT=3000

# Optional: Shopware-Zugang und Anzeigename lassen sich in der App unter "Einstellungen" pflegen.
# Die Variablen gelten nur als Voreinstellung.
# SHOPWARE_URL=
# SHOPWARE_CLIENT_ID=
# SHOPWARE_CLIENT_SECRET=
# OWN_SHOP_NAME=BelKai
# OWN_SHOP_URL=https://www.belkai.de
